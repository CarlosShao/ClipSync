# 复制为 .env.test 后填入本地测试库凭据（值需与 docker-compose.dev.yml 的 dev 默认一致）。
# 本文件只放敏感凭据的键结构；数据库名/端口等非敏感配置由 src/config/test.js 控制。

# 数据库密码（对应 docker-compose.dev.yml 的 POSTGRES_PASSWORD）
DB_PASSWORD=CHANGE_ME_test_only

# Redis 密码（对应 docker-compose.dev.yml 的 --requirepass）
REDIS_PASSWORD=CHANGE_ME_test_only

# JWT 签名密钥（仅测试用；生产必须更换，至少 32 字符）
JWT_SECRET=CHANGE_ME_test_only

# 加密密钥（仅测试用；生产必须更换，至少 32 字符）
ENCRYPTION_KEY=CHANGE_ME_test_only

# CSRF 密钥（仅测试用；生产必须更换，至少 32 字符）
CSRF_SECRET=CHANGE_ME_test_only
