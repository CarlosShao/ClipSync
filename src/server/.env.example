# ============================================
# ClipSync 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================

# ============================================
# 服务器配置
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# 请求超时（毫秒）
REQUEST_TIMEOUT=30000

# ============================================
# AI 供应商上游地址策略（SSRF）
# ============================================
# 是否放行「本地/内网」上游地址：回环 127.0.0.0/8、::1、localhost；私网 10/8、172.16/12、
# 192.168/16；IPv6 ULA fc00::/7。主机名同样按解析结果判定（先解析 → 再对每条解析结果判定，
# DNS 重绑定防护不退化；解析失败/无记录一律拒绝 fail-closed）。
#
# 默认 true —— 本产品是自托管 / 桌面优先：本地模型网关（one-api / vLLM / Ollama / LM Studio，
# 例如 http://127.0.0.1:3800/v1）是**正当用法**，默认就该能连，而不是被当成 SSRF 拒掉。
# 设为 false 恢复旧行为：一律禁止内网 / 环回地址（部署在公网、且不信任本机/内网时可用）。
AI_ALLOW_LOCAL_BASE_URL=true

# 与上面开关**无关**、永远拒绝的底线（放行内网不等于拆掉防线）：
#   - 云元数据 / 链路本地：169.254.0.0/16（含 169.254.169.254）、IPv6 fe80::/10；
#   - 广播 / 组播 / 保留 / 未指定段：0.0.0.0/8、224.0.0.0/4、240.0.0.0/4、255.255.255.255、
#     TEST-NET 文档段、100.64/10 CGNAT、100::/64、2001:db8::/32、:: 等；
#   - 非 http/https 协议（file: / gopher: / ftp: …）；
#   - 云元数据主机名（metadata.google.internal / metadata）与内网域名后缀（.local/.internal/.svc）；
#   - 畸形 / 超长（>2048 字符）/ 带用户信息（user:pass@）的 URL。
# 被拒时接口返回稳定机器码（ai_base_url_blocked_address / ai_base_url_local_disabled /
# ai_base_url_unresolved / ai_base_url_scheme_not_allowed …），桌面端据此映射成人话提示；
# 判定入口唯一（utils/aiProviders.js 的 checkUpstreamUrl），保存供应商、未保存预览
# fetch-models、搜索源 search-test 与所有出站请求共用同一口径。
#
# 容器部署注意：放行的是**服务端自身视角**的地址。API 若跑在 Docker 里，容器内的 127.0.0.1
# 指的是容器自己 —— 要连宿主机上的本地模型网关，请用宿主机别名
# （http://host.docker.internal:3800/v1，需给容器加 extra_hosts:
#   "host.docker.internal:host-gateway"）或宿主机的内网 IP（如 http://192.168.1.10:8000/v1）。

# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clipsync
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================
# JWT配置
# ============================================
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ============================================
# CORS配置
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ============================================
# WebSocket配置
# ============================================
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=5000

# ============================================
# 加密配置
# ============================================
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# ============================================
# 支付Webhook签名验证配置
# ============================================

# 微信支付
WECHAT_PAY_APIV3_KEY=your_wechat_pay_apiv3_key
WECHAT_PAY_MCH_ID=your_merchant_id

# 支付宝
ALIPAY_PUBLIC_KEY=your_alipay_public_key_in_pem_format

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ============================================
# 邮件配置（可选）
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# ============================================
# 应用内反馈工单收件邮箱（可选）
# ============================================
# 桌面端「设置 → 关于 ClipSync → 发送反馈」提交的工单会落库 feedback_tickets，
# 并尽力转发到该邮箱（POST /api/feedback，见 src/routes/feedback.js）。
# 未设置时用代码内默认值 swqcarlos@clipchain.top。
# 注意：这里只是**收件地址**，不是密钥；真正的 SMTP 凭据在管理台「邮件通道」里配置。
FEEDBACK_TO=

# ============================================
# 对象存储配置（D1，可选）
# ============================================
# 默认 local（本地磁盘）。多实例部署必须切 s3，否则 A 实例上传的文件 B 实例读不到。
# 兼容阿里云 OSS / 腾讯 COS / AWS S3 / 自建 MinIO（均为 S3 协议）。
# 自建 MinIO 见 docker-compose.dev.yml 的 minio 服务；生产建议独立部署并改默认口令。
STORAGE_TYPE=local
S3_BUCKET=clipsync-uploads
S3_REGION=us-east-1
# MinIO/自建：http://<host>:9000 ；阿里云 OSS：https://oss-cn-hangzhou.aliyuncs.com（region 填 oss-cn-hangzhou）
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================
# 推送通知配置（可选）
# ============================================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ============================================
# 监控配置（可选）
# ============================================
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Prometheus 抓取 /api/metrics 的 Bearer 口令。
# 生产环境【必须】设置：未设置时 /api/metrics 直接返回 503（fail-closed），
# 不再回退到写死在代码里的公开默认口令（原 clipsync-metrics-dev-token）。
METRICS_TOKEN=
SENTRY_DSN=https://your_sentry_dsn@sentry.io/xxx
