# 生产环境变量模板
# 复制此文件为 .env.production 并修改所有默认值
# ⚠️ 警告：生产环境必须使用强密码，不允许使用默认值

# ===== 数据库配置 =====
DB_HOST=postgres-prod
DB_PORT=5432
DB_NAME=clipsync
DB_USER=clipsync
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS

# ===== Redis 配置 =====
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===== 服务端口 =====
API_PORT=3000

# ===== 安全配置（生产环境必须修改）=====
# JWT 密钥：至少 32 字符随机字符串
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS_RANDOM_STRING

# 加密密钥：必须 32 字符
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_CHARS!!

# CSRF 密钥：至少 32 字符随机字符串
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_AT_LEAST_32_CHARS

# ===== 文件上传 =====
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# ===== CORS（生产环境必须指定具体域名）=====
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ===== 日志 =====
LOG_LEVEL=info

# ===== 其他 =====
TZ=Asia/Shanghai

# ===== 可选：监控和告警 =====
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_ENABLED=true
# GRAFANA_ENABLED=true
